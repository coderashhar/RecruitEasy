# Clerk — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Neon — https://console.neon.tech → Connection string (pooled)
# Append `connect_timeout=30` to the query string. Neon suspends an idle
# branch, and the wake-up can outrun Prisma's 5s default — which surfaces
# as "Can't reach database server", not as a timeout.
DATABASE_URL=

# Realtime service — the URL apps/realtime is reachable at
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
REALTIME_JWT_SECRET=

# LiveKit Cloud — https://cloud.livekit.io → Settings → Keys (ADR-001)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Judge0 — reachable only from the server, never exposed to the client.
# Stand up infra/judge0 (see its README) and match JUDGE0_AUTH_TOKEN to the
# AUTHN_TOKEN in infra/judge0/judge0.conf — without it every request is
# rejected, since that stack has no unauthenticated mode configured.
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=

# Cloudflare R2 — S3-compatible object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Upstash Redis — rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — scheduling emails and reminders
RESEND_API_KEY=
# Sender, and the ORGANIZER on calendar invites. "Name <address>" or a bare address.
EMAIL_FROM="InterviewHub AI <noreply@yourdomain.com>"

# Public origin of this app — used for links in emails and calendar invites.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for /api/cron/* (reminders). Generate with `openssl rand -hex 32`.
# Must match CRON_SECRET wherever the scheduler runs (infra/caddy's cron service).
# Unset, every cron request is refused.
CRON_SECRET=

# ATS scoring
GEMINI_API_KEY=
