# Clerk — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Neon — https://console.neon.tech → Connection string (pooled)
DATABASE_URL=

# Realtime service — the URL apps/realtime is reachable at
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
REALTIME_JWT_SECRET=

# LiveKit Cloud — https://cloud.livekit.io → Settings → Keys (ADR-001)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Judge0 — reachable only from the server, never exposed to the client
JUDGE0_URL=http://localhost:2358

# Cloudflare R2 — S3-compatible object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Upstash Redis — rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — scheduling emails
RESEND_API_KEY=

# ATS scoring
GEMINI_API_KEY=
