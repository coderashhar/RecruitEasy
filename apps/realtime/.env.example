PORT=4000

# Must match REALTIME_JWT_SECRET in apps/web/.env.local — the web app signs
# join tokens with this, this service verifies them (see plan §5, "Joining
# an interview").
REALTIME_JWT_SECRET=

# Same Neon connection string as the other apps — used for CodeDocument
# snapshot persistence.
DATABASE_URL=

# Comma-separated origins allowed to open a socket connection.
CORS_ORIGIN=http://localhost:3000
