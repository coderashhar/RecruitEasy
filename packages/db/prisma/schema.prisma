generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CANDIDATE
  INTERVIEWER
  RECRUITER
  ADMIN
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewParticipantRole {
  CANDIDATE
  INTERVIEWER
  OBSERVER
}

enum AtsSource {
  LLM
  HEURISTIC
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  TIMEOUT
}

enum RecordingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  // The file was deleted under the retention policy; the row remains so the
  // interview page can say so rather than "not recorded".
  EXPIRED
}

enum FeedbackRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

enum IntegritySignalType {
  TAB_BLUR
  PASTE
  FULLSCREEN_EXIT
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  jobs      Job[]
  auditLogs AuditLog[]
  dataDeletionRequests DataDeletionRequest[]

  @@map("organizations")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role      UserRole
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes               Resume[]
  applicationsAsCandidate Application[]        @relation("CandidateApplications")
  interviewParticipants  InterviewParticipant[]
  feedback               Feedback[]
  notifications          Notification[]
  auditLogs               AuditLog[]
  chatMessages           ChatMessage[]
  dataDeletionRequests      DataDeletionRequest[] @relation("DeletionRequestedBy")
  processedDeletionRequests DataDeletionRequest[] @relation("DeletionProcessedBy")
  calendarAccounts       CalendarAccount[]

  @@index([orgId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Hiring pipeline
// ---------------------------------------------------------------------------

model Job {
  id             String   @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title          String
  description    String
  requiredSkills String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications Application[]

  @@index([orgId])
  @@map("jobs")
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User              @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(APPLIED)
  // A recruiter's private marker for "worth a closer look", independent of
  // where the application is in the pipeline. Never shown to the candidate.
  shortlistedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  resumes     Resume[]
  interviews  Interview[]

  // One application per candidate per job. Nothing previously stopped a
  // recruiter adding the same candidate to the same job twice, which would
  // show as duplicate pipeline rows and let two interviews be scheduled
  // against what is really one application.
  //
  // This also serves lookups filtered by jobId alone (leftmost prefix), so a
  // separate @@index([jobId]) would be dead weight on every write.
  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// Resume & ATS
// ---------------------------------------------------------------------------

model Resume {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  fileKey       String
  parsedText    String?
  createdAt     DateTime @default(now())

  atsReports AtsReport[]

  @@index([applicationId])
  @@map("resumes")
}

model AtsReport {
  id              String    @id @default(cuid())
  resumeId        String
  resume          Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  score           Int
  missingKeywords String[]
  skillsMatch     Json
  suggestions     Json
  source          AtsSource
  model           String?
  createdAt       DateTime  @default(now())

  @@index([resumeId])
  @@map("ats_reports")
}

// ---------------------------------------------------------------------------
// Interviews
// ---------------------------------------------------------------------------

model Interview {
  id            String           @id @default(cuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  durationMins  Int              @default(60)
  round         Int              @default(1)
  status        InterviewStatus  @default(SCHEDULED)
  roomName      String           @unique
  // RFC 5545 SEQUENCE for the calendar invite. A calendar client only applies
  // an update or cancellation whose SEQUENCE is higher than the copy it holds,
  // so every reschedule and cancellation must bump this before sending.
  icsSequence   Int              @default(0)
  // Set when each reminder is claimed by the cron run that sends it, which is
  // what stops two overlapping runs from both emailing. Cleared on reschedule.
  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  participants  InterviewParticipant[]
  codeDocument  CodeDocument?
  executions    Execution[]
  recording     Recording?
  feedback      Feedback[]
  integritySignals IntegritySignal[]
  chatMessages  ChatMessage[]
  calendarEvents CalendarEvent[]

  @@index([applicationId])
  // The reminder sweep's range scan over upcoming SCHEDULED interviews.
  @@index([status, scheduledAt])
  @@map("interviews")
}

model InterviewParticipant {
  id          String                   @id @default(cuid())
  interviewId String
  interview   Interview                @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        InterviewParticipantRole

  @@unique([interviewId, userId])
  @@map("interview_participants")
}

// One live shared document per interview — the realtime service holds a
// single in-memory Y.Doc per room and persists its encoded snapshot here.
model CodeDocument {
  id          String    @id @default(cuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  language    String
  snapshot    Bytes
  finalCode   String?
  updatedAt   DateTime  @updatedAt

  @@map("code_documents")
}

model Execution {
  id          String          @id @default(cuid())
  interviewId String
  interview   Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  language    String
  source      String
  stdin       String?
  stdout      String?
  stderr      String?
  status      ExecutionStatus @default(QUEUED)
  timeMs      Int?
  memoryKb    Int?
  createdAt   DateTime        @default(now())

  @@index([interviewId])
  @@map("executions")
}

// One recording per interview, made by LiveKit Egress and uploaded to R2.
// status: PENDING while recording, PROCESSING once stopped and LiveKit is
// finishing the file, READY when the file is in R2, FAILED otherwise (with
// the reason in `error`). See lib/recording.ts.
model Recording {
  id          String          @id @default(cuid())
  interviewId String          @unique
  interview   Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  // Unique: LiveKit's webhook identifies the recording only by this.
  egressId    String          @unique
  fileKey     String?
  durationSec Int?
  status      RecordingStatus @default(PENDING)
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@map("recordings")
}

model Feedback {
  id             String                  @id @default(cuid())
  interviewId    String
  interview      Interview               @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId  String
  interviewer    User                    @relation(fields: [interviewerId], references: [id])
  rubricScores   Json
  notes          String?
  recommendation FeedbackRecommendation
  createdAt      DateTime                @default(now())

  // One feedback per interviewer per interview. Resubmitting is an update of
  // that interviewer's own row, not a second opinion from the same person —
  // without this, a double-submit silently doubles their weight in review.
  @@unique([interviewId, interviewerId])
  @@index([interviewId])
  @@map("feedback")
}

// In-room chat. Persisted so a reload or a dropped connection doesn't wipe
// the conversation, and so a reviewer can read what was said alongside the
// code and the feedback.
model ChatMessage {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())

  @@index([interviewId, createdAt])
  @@map("chat_messages")
}

model IntegritySignal {
  id          String              @id @default(cuid())
  interviewId String
  interview   Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  type        IntegritySignalType
  payload     Json?
  occurredAt  DateTime            @default(now())

  @@index([interviewId])
  @@map("integrity_signals")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([orgId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Rate limiting
// ---------------------------------------------------------------------------

// One row per consumed unit of a limited action (a resume polish, a practice
// run). Deliberately not AuditLog: that table is org-scoped by foreign key and
// meant for humans to read, and borrowing it for counters is what previously
// broke the polish limit — the insert needed an orgId it didn't have, failed,
// and the failure was swallowed, so the count never moved.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

// ---------------------------------------------------------------------------
// Privacy
// ---------------------------------------------------------------------------

enum DataDeletionStatus {
  PENDING
  COMPLETED
  REJECTED
}

// A candidate's request to have their data removed (PRD §9: candidates can
// request deletion). Completing one deletes the candidate's user row, so
// `userId` becomes null: the record that a deletion happened must not keep
// the person it deleted.
model DataDeletionRequest {
  id            String             @id @default(cuid())
  orgId         String
  org           Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?              @relation("DeletionRequestedBy", fields: [userId], references: [id], onDelete: SetNull)
  status        DataDeletionStatus @default(PENDING)
  // Why an admin rejected it; shown to the candidate.
  reason        String?
  requestedAt   DateTime           @default(now())
  processedAt   DateTime?
  processedById String?
  processedBy   User?              @relation("DeletionProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([userId])
  @@map("data_deletion_requests")
}

// ---------------------------------------------------------------------------
// External calendars (PRD FR-5.3)
// ---------------------------------------------------------------------------

enum CalendarProvider {
  GOOGLE
}

/**
 * One person's connected external calendar. `@@unique([userId, provider])`
 * rather than a bare unique on userId: a second provider is a row, not a
 * migration.
 *
 * The two token columns hold ciphertext, never the tokens themselves — a
 * refresh token is a bearer credential for someone's whole calendar, and the
 * database is the one place in this system that holds other people's. See
 * lib/token-cipher.ts.
 */
model CalendarAccount {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     CalendarProvider @default(GOOGLE)
  /** Which Google account this is, so the settings page can name it. */
  accountEmail String
  calendarId   String           @default("primary")
  accessToken  String
  refreshToken String
  /** When accessToken stops working; refreshed before it is reached. */
  expiresAt    DateTime
  scope        String
  /** Connected but paused: kept so reconnecting isn't a fresh consent screen. */
  syncEnabled  Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  events CalendarEvent[]

  @@unique([userId, provider])
  @@map("calendar_accounts")
}

/**
 * The event this interview has on one person's calendar. Without this row a
 * reschedule could only add a second event — the provider's own event id is
 * the only handle for patching or deleting the first.
 */
model CalendarEvent {
  id                String          @id @default(cuid())
  interviewId       String
  interview         Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  calendarAccountId String
  calendarAccount   CalendarAccount @relation(fields: [calendarAccountId], references: [id], onDelete: Cascade)
  /** The provider's event id. */
  externalId        String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // One event per interview per calendar: the upsert key that makes a repeated
  // sync idempotent instead of duplicating the event.
  @@unique([interviewId, calendarAccountId])
  @@index([calendarAccountId])
  @@map("calendar_events")
}
