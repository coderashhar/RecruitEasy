# Same Neon connection string as apps/web/.env.local — Prisma CLI reads this
# directly when you run migrate/studio from this package.
# Append `connect_timeout=30` to the query string. Neon suspends an idle
# branch, and the wake-up can outrun Prisma's 5s default — which surfaces
# as "Can't reach database server", not as a timeout.
DATABASE_URL=
